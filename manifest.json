{
  "manifest_version": 3,
  "name": "Alignly – Text Alignment & Direction",
  "short_name": "Alignly",
  "version": "1.0.0",
  "description": "Align text left or right (LTR / RTL) for a whole page or just the section you select.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Alignly",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "run_at": "document_start" }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "alignly@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
